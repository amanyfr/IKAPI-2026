# Salin ke .env lalu sesuaikan.
# MySQL (default Laragon: root tanpa password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ikapi_jabar

# Wajib diisi di production (string acak panjang)
JWT_SECRET=
# PORT=5000
# ENABLE_DEMO_SWITCH=true
# CORS_ORIGIN=http://localhost:3000

# Email (verifikasi akun, reset kata sandi, notifikasi status).
# Kosongkan SMTP_HOST untuk mematikan email: akun baru langsung terverifikasi,
# isi email hanya dicatat di tabel email_logs dan console server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="IKAPI Jawa Barat <no-reply@ikapi-jabar.or.id>"
# Alamat aplikasi untuk tautan di email
APP_URL=http://localhost:3000

# CDN untuk isi file unggahan (foto, dokumen, bukti transfer). Kosongkan CDN_API_KEY
# untuk tetap menyimpan file di MySQL. API key project diambil dari dasbor CDN Kroombox.
# File lama dipindah dengan: node server/files-to-cdn.js  (lalu --hapus-data)
CDN_URL=https://cdn.kroombox.com
CDN_API_KEY=
# Opsional: id folder tujuan di CDN
CDN_FOLDER_ID=
